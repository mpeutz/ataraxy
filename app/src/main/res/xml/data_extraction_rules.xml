<?xml version="1.0" encoding="utf-8"?>
<!-- Journal and practice data stay on this device: no cloud backup, no device-to-device transfer.
     allowBackup="false" covers Android 11 and lower; these rules cover Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
    </device-transfer>
</data-extraction-rules>
