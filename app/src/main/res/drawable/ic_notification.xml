<?xml version="1.0" encoding="utf-8"?>
<!-- Status bar mark: the launcher's ring and open "A", with heavier strokes so it
     survives at 24dp. Notification icons are drawn as white-on-transparent silhouettes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 Z"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.5" />
    <group>
        <clip-path android:pathData="M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 Z" />
        <path
            android:pathData="M3.3,22.2 L12,1.2 L20.7,22.2"
            android:strokeColor="@android:color/white"
            android:strokeLineJoin="miter"
            android:strokeWidth="1.75" />
    </group>
</vector>
