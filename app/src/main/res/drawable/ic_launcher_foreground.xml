<?xml version="1.0" encoding="utf-8"?>
<!-- Ataraxy launcher mark: a thin ring with an open "A" (no crossbar) whose
     tip and legs run flush into the ring. Sized to sit comfortably inside the
     launcher mask (ring radius 22 of the visible 36). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,32 A22,22 0 1,1 54,76 A22,22 0 1,1 54,32 Z"
        android:strokeColor="@color/launcher_mark"
        android:strokeWidth="2.6" />
    <group>
        <clip-path android:pathData="M54,32 A22,22 0 1,1 54,76 A22,22 0 1,1 54,32 Z" />
        <path
            android:pathData="M32.7,78.9 L54,27.6 L75.3,78.9"
            android:strokeColor="@color/launcher_mark"
            android:strokeLineJoin="miter"
            android:strokeWidth="3" />
    </group>
</vector>
